# lid5_gradcheck.config -- Phase 4b Task 9 (Algo 5, wav, corpus gradCheck).
# lid5.config with a TINY net (every GEMM reduction dim < 23 -> the REAL compiled
# engine matches the ascending-loop port bit-for-bit), backprop active, SQUARE cost
# laws (strict-bits goldens, no libm canary), InputNormalizationType 0 (no
# self-norm), nb_DCT 0 (filterbank-only scoring input, no Eigen DCT GEMM), and a
# 1-file wav corpus. The Algo-5 gradCheck pins the LID cost columns: cost row[14],
# counter row[len-2] (CorpusProcessor.cpp:278-280). The LTSV SAD (rising threshold
# -1e6) labels the whole file SPEECH, so the per-segment LID scoring FFB always runs.
Algo_choice 5
Audio_offset 0
Audio_max_duration 2.0
numOuterThreads 1
Neural_Networks_BackPropagation_Epochs 0
Neural_Networks_Gradient_Check_Epsilon 1e-5
multiConfigResultsOutputFile lid5_gc.mat
BLSTM_decision_thresh_rising -1000000
BLSTM_decision_area_rising -1000000
BLSTM_decision_thresh_falling -2000000
BLSTM_decision_area_falling 0
BLSTM_windowing_type hHCw
BLSTM_windowing_param 3.714451255350461e-01
BLSTM_convolution_window_type hHCw
BLSTM_convolution_window_size 0
BLSTM_flag_DCOffset false
BLSTM_preemph_ratio -9.700000000000000e-01
BLSTM_noise_seed -3
BLSTM_noise_ratio 1.000000000000000e-02
BLSTM_speech_padding 0,0,0,0
BLSTM_min_silence 0.001,0.001
BLSTM_min_speech 0.001,0.001,0.001
BLSTM_spectrum_order 10
BLSTM_spectrum_shift 1.000000000000000e-02
BLSTM_spectrum_temporal_convolution_type uniform
BLSTM_spectrum_temporal_convolution_size 0
BLSTM_window 0
BLSTM_shift 8.000000000000000e-01
BLSTM_LTSVwindow 0
BLSTM_LTSVshift 5.657759158904229e-02
BLSTM_TDCwindow 0
BLSTM_TDC_lags 0,0
BLSTM_TDC_balance 5.439183651566210e-01
BLSTM_TDCshift 2.000000000000000e-01
BLSTM_TDC_windowing_type uniform
BLSTM_TDC_windowing_param 5.534716888700572e-01
BLSTM_minFreq 100
BLSTM_maxFreq 3800
BLSTM_minMelFreq 1.861001763856132e+02
BLSTM_maxMelFreq 2.502400490895474e+03
BLSTM_nb_bins 20
BLSTM_is_log_mel true
BLSTM_nb_DCT 0
BLSTM_ComputeDeltasNb 0
BLSTM_ComputeDeltaDeltasNb 0
BLSTM_IgnoreFirstDCT true
BLSTM_BackPropagationActivated true
BLSTM_TwoSweeps false
BLSTM_LSTMNeuronNb 8,4
BLSTM_LSTMSubSampling 1
BLSTM_NNetInputSize 8
BLSTM_OutputNeuronNb 8,1
BLSTM_OutputSubSampling 1
BLSTM_weightsFile tiny_sad_seed.bin
BLSTM_CostLawSpeech square
BLSTM_CostLawNoSpeech square
BLSTM_CostLawParamSpeech 0
BLSTM_CostLawParamNoSpeech 0
BLSTM_CostLawThreshSpeech 1
BLSTM_CostLawThreshNoSpeech 0
BLSTM_use_cep_files 0
BLSTM_InputNormalizationType 0
BLSTM_Forward_IsCellsPeepholesActive true
BLSTM_Backward_IsCellsPeepholesActive true
BLSTM_Forward_IsGatesPeepholesActive true
BLSTM_Backward_IsGatesPeepholesActive true
BLSTM_Forward_IsGatesRecurrentPeepholesActive true
BLSTM_Backward_IsGatesRecurrentPeepholesActive true
language2classmapping languagemapping_lid7.csv
fileslisting listing_gc_wav.csv
File_Type 0
